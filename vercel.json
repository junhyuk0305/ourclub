{
  "rewrites": [
    {
      "source": "/clubs/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|kakaotalk|twitterbot|slackbot|discordbot|linkedinbot|telegrambot|whatsapp|line-poker|skypeuripreview|naver|yeti|daumoa|googlebot|bingbot|pinterest|redditbot|embedly|vkshare|w3c_validator).*"
        }
      ],
      "destination": "/api/og?slug=:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
