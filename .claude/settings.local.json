{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(git checkout *)",
      "Bash(git mv *)",
      "Bash(cp src/pages/public.ts src/pages/public/index.ts)",
      "Bash(cp src/pages/admin.ts src/pages/admin/index.ts)",
      "Bash(cp src/pages/user.ts src/pages/user/index.ts)",
      "Bash(cp src/pages/corp.ts src/pages/corp/index.ts)",
      "Bash(rm src/pages/public.ts src/pages/admin.ts src/pages/user.ts src/pages/corp.ts)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git stash *)",
      "Bash(xargs grep *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git ls-files *)",
      "Bash(git show *)",
      "Bash(git branch *)"
    ]
  },
   "statusLine": {
    "enabled": true
  },
   "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp"
  }
}

